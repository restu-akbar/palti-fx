# Salin ke .env lalu isi dari Supabase Dashboard → Project Settings → API
# (gunakan anon/publishable key, JANGAN service_role)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# URL publik kebijakan privasi (tampil di profil; wajib untuk App Store). Contoh: https://domain-anda/privacy.html
EXPO_PUBLIC_PRIVACY_URL=
