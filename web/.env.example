VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Penyimpanan gambar & video materi: 'supabase' (default) atau 'r2' (Cloudflare R2 lewat /api/upload-url).
VITE_STORAGE_DRIVER=supabase
VITE_STORAGE_BUCKET=lesson-images
VITE_STORAGE_VIDEO_BUCKET=lesson-videos
# Hanya untuk driver r2: domain publik bucket palti-lesson-media (tanpa slash akhir). Bucket Supabase di atas
# tetap dipakai untuk mengenali URL lama selama masa transisi.
VITE_R2_PUBLIC_BASE_URL=
# Opsional: ganti endpoint Pages Function (default /api/upload-url)
# VITE_UPLOAD_API_URL=
#
# Secret Pages Function (bukan VITE_*; setel di Cloudflare Pages, jangan di berkas ini):
# SUPABASE_URL, SUPABASE_ANON_KEY, R2_ACCOUNT_ID, R2_BUCKET, R2_PUBLIC_BASE_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
