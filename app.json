{
  "expo": {
    "name": "Palti FX",
    "slug": "palti-fx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./mobile/assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paltifx.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.paltifx.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08080A",
        "foregroundImage": "./mobile/assets/android-icon-foreground.png",
        "monochromeImage": "./mobile/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./mobile/assets/favicon.png",
      "name": "Palti FX",
      "backgroundColor": "#08080A",
      "themeColor": "#08080A"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./mobile/assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#08080A"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "7d14e548-b909-49b1-bf07-65ac9904bbab"
      }
    },
    "owner": "dio-rahman-putra"
  }
}
