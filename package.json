{
  "name": "palti-fx",
  "version": "1.0.0",
  "private": true,
  "main": "mobile/index.ts",
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
    "start": "npm run start --workspace=mobile",
    "start:mobile": "npm run start --workspace=mobile",
    "start:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:apk": "npm run build:apk --workspace=mobile",
    "build:release": "npm run build:release --workspace=mobile",
    "build:mobile": "npm run build:release --workspace=mobile",
    "android": "npm run android --workspace=mobile",
    "ios": "npm run ios --workspace=mobile",
    "prebuild:ios": "npm run prebuild:ios --workspace=mobile",
    "build:ios": "npm run build:ios --workspace=mobile",
    "lint": "npm run lint --workspace=mobile",
    "lint:mobile": "npm run lint --workspace=mobile",
    "test": "npm run test --workspaces --if-present",
    "test:mobile": "npm run test --workspace=mobile",
    "test:web": "npm run test --workspace=web",
    "test:coverage:mobile": "npm run test:coverage --workspace=mobile",
    "test:coverage:web": "npm run test:coverage --workspace=web",
    "test:db": "npm run test:db --workspace=mobile"
  }
}
